# Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=epAdminDev
DB_PASSWORD=epPasswordDev2024
DB_NAME=e_parapheur_dev
DB_SYNCHRONIZE=true
DB_LOGGING=true

# Example for MySQL/phpMyAdmin:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=e_parapheur

# Database SSL (optional)
DB_SSL=false

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=3600

# Application Configuration
NODE_ENV=development
API_PORT=3000
API_URL=http://localhost:3000

# OnlyOffice Configuration
ONLYOFFICE_URL=http://localhost/onlyoffice
ONLYOFFICE_DB_HOST=postgres
ONLYOFFICE_DB_PORT=5432
ONLYOFFICE_DB_NAME=onlyoffice_dev
ONLYOFFICE_DB_USER=onlyoffice_user
ONLYOFFICE_DB_PASSWORD=onlyoffice_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail Configuration (for notifications)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@example.com
MAIL_PASSWORD=your-password
MAIL_FROM=noreply@e-parapheur.com

# Document Storage
STORAGE_PATH=/app/storage
MAX_FILE_SIZE=104857600

# Signature Configuration
SIGNATURE_ALGORITHM=SHA256
SIGNATURE_KEY_PATH=/app/certs/signature.key

# QR Code Configuration
QR_CODE_SIZE=200
QR_CODE_ERROR_CORRECTION=H

# Logging
LOG_LEVEL=debug

# Session Configuration
SESSION_SECRET=change-this-secret-key
SESSION_TIMEOUT=86400
